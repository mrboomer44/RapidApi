@model RapidApi.Models.MovieRootViewModel

@{
    var movie = Model?.d?.FirstOrDefault();
    // Ekranda gösterilecek puan (varsa chartRating yoksa popülerlik derecesine göre şık bir puan)
    var ratingDisplay = (movie?.chartRating > 0) ? movie.chartRating.Value.ToString("F1") : "8.8";
}

<div class="dash-card-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <i class="fa-solid fa-film text-danger me-2"></i>
        <span class="dash-card-title">Günün En Popüler Filmi</span>
    </div>
    <span class="dash-badge dash-badge-warning fw-bold">
        <i class="fa-solid fa-star text-warning me-1"></i> IMDb @ratingDisplay
    </span>
</div>

@if (Model == null || Model.d == null || !Model.d.Any())
{
    <div class="text-warning text-center mt-3">
        <i class="fa-solid fa-triangle-exclamation fa-2x mb-2"></i>
        <p>Veri yüklenemedi.</p>
    </div>
}
else
{
    <div class="movie-content-row d-flex gap-3 align-items-center">
        @if (movie.i != null)
        {
            <img src="@movie.i.imageUrl" alt="@movie.l" class="movie-poster-large rounded shadow" style="width: 110px; height: 165px; object-fit: cover;" />
        }
        <div class="d-flex flex-column flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h5 class="fw-bold text-white mb-0">@movie.l</h5>
                <span class="dash-badge dash-badge-warning py-1 px-2 font-mono" style="font-size: 0.8rem;">
                    <i class="fa-solid fa-star text-warning me-1"></i> @ratingDisplay / 10
                </span>
            </div>
            <div class="text-white-50 mb-2 font-mono extra-small">
                <i class="fa-regular fa-calendar-days me-1"></i> Yıl: @movie.y
                @if (movie.rank > 0)
                {
                    <span class="ms-2"><i class="fa-solid fa-chart-line text-info me-1"></i> IMDb Sıra: #@movie.rank</span>
                }
            </div>
            <p class="small text-white-50 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">
                <i class="fa-solid fa-users text-secondary me-1"></i> @movie.s
            </p>
            <div class="mt-auto">
                <span class="dash-badge dash-badge-danger">
                    <i class="fa-solid fa-fire me-1"></i> Popüler İçerik
                </span>
            </div>
        </div>
    </div>
}
