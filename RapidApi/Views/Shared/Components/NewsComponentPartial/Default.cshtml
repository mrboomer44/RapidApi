@model RapidApi.Models.RealTimeNewsRootViewModel

<div class="dash-card-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <i class="fa-solid fa-newspaper text-primary me-2"></i>
        <span class="dash-card-title">Güncel Haber İçeriği</span>
    </div>
    <span class="dash-badge dash-badge-info">Son Dakika Akışı</span>
</div>

@if (Model == null || Model.data == null || !Model.data.Any())
{
    <div class="text-warning text-center mt-3 py-3">
        <i class="fa-solid fa-triangle-exclamation fa-2x mb-2 d-block"></i>
        <p class="mb-0">Veri yüklenemedi.</p>
    </div>
}
else
{
    <div class="news-cards-wrapper">
        @foreach (var article in Model.data.Take(3))
        {
            <div class="news-card-box">
                @if (!string.IsNullOrEmpty(article.photo_url))
                {
                    <img src="@article.photo_url" class="news-img" alt="@article.title" />
                }
                <div class="news-body">
                    <span class="dash-badge dash-badge-dark align-self-start mb-2" style="font-size: 0.7rem;">@article.source_name</span>
                    <h6 class="fw-bold text-white mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        <a href="@article.link" target="_blank" class="text-white text-decoration-none">@article.title</a>
                    </h6>
                    <p class="text-white-50 extra-small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@article.snippet</p>
                </div>
            </div>
        }
    </div>
}
